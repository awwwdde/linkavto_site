from django.contrib.auth.models import User
# Показать всех суперпользователей
superusers = User.objects.filter(is_superuser=True)
for user in superusers:
    print(f"Username: {user.username}, Email: {user.email}, Superuser: {user.is_superuser}")
# Если нет суперпользователей, создадим
if not superusers.exists():
    admin = User.objects.create_superuser(
        username='root',
        email='admin@linkavto.ru',
        password='linkavto2025'
    )
    print("✅ Суперпользователь создан!")
    print("Username: root")
    print("Password: linkavto2025")
else:
    # Сбросим пароль для root
    try:
        user = User.objects.get(username='root')
        user.set_password('linkavto2025')
        user.is_superuser = True
        user.is_staff = True
        user.save()
        print("✅ Пароль для root изменен!")
        print("Username: root")
        print("Password: linkavto2025")
    except:
        print("❌ Пользователь root не найден")
exit()
