from accounts.models import Address
# Посмотреть все адреса
addresses = Address.objects.all()
print(f"Всего адресов: {addresses.count()}")
# Проверить первый адрес
if addresses.exists():
    addr = addresses.first()
    print(f"ID: {addr.id}")
    print(f"Address: {addr.full_address}")
    try:
        print(f"Delivery type: {addr.delivery_type}")
    except AttributeError as e:
        print(f"ERROR: {e}")
    
    # Проверить какие поля есть
    print(f"Fields: {[f.name for f in addr._meta.fields]}")
exit()
